# Python virtual environments
.venv/
env/
venv/
ENV/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local raw captures and large datasets
*.pcap
*.pcapng
*.cap
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Local experiment runs (keep synthetic smoke test reference if needed)
data/results/*
!data/results/.gitkeep

# Independent local checkout, not a submodule
/DoH-Tunneling-Detection/

# Keep report scripts, aggregate evidence and figures; large bundles stay local
/reports/final_experiment_results_*/processed/
/reports/final_experiment_results_*/predictions/
/reports/final_experiment_results_*/models/
/reports/final_experiment_results_*/test_temp/
/reports/final_experiment_results_*/*.log

# Local environment settings and credentials
.env
.env.*
!.env.example

# System & IDE artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/

# Reproducible development maps are retained; machine-local Graphify state is not source.
/graphify-out/cache/
/graphify-out/.graphify_python
/graphify-out/.graphify_root
/graphify-out/.vocab.txt
/graphify-out/.cloud-cta-shown

# Historical temporary fixtures and new verification scratch space
/reports/phase10_verification/test_tmp/
/reports/cleanup_verification_*/scratch/
/reports/cleanup_verification_*/*.log
/reports/cleanup_verification_*/smoke/
/reports/cleanup_verification_*/inspection/
/reports/local_archive/
/powershell.cmd
/earch*
/reproductions/
